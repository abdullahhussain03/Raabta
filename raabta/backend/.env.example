# Server
NODE_ENV=development
# Render assigns PORT dynamically in production — do not hardcode it there.
PORT=5000

# Frontend origin(s) for CORS + email links. Comma-separate multiple origins
# (e.g. local dev + Vercel preview + production) with no spaces around commas.
FRONTEND_URL=http://localhost:5173

# Database (MongoDB Atlas in production — supports mongodb+srv://)
MONGO_URI=mongodb://localhost:27017/raabta

# JWT
JWT_ACCESS_SECRET=Y7mQ9xLp2VzK8nRw4HdFa1JcTu6BeX3GsPq0NiM5oUlZr8WvCyE2AkJh7DtSf9PbGnLmQ4RxVc8YwTe1UzKo6HiNf3JdAp5CsXbM9qLr7Ev
JWT_REFRESH_SECRET=nF4zQx8PmK1WyJc7RbHv2LgT9SaXe5UdMo3AiNp6VkYr0BwEfHs8CtJqZ4DuGlXmRnP5KvTc9YaWi2SeLo7BjQf1UhMx8PrNzGdEv6AcHt
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cookies — set true in production (Render serves over HTTPS)
COOKIE_SECURE=false

# Email (use a real SMTP provider in production, e.g. SendGrid/SES)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
EMAIL_FROM="Raabta <no-reply@raabta.app>"

# CAPTCHA (hCaptcha or reCAPTCHA)
CAPTCHA_SECRET=replace_with_captcha_secret

# File uploads — Cloudinary (used from the start; Render's filesystem is
# ephemeral so local disk storage would lose files on every redeploy)
CLOUDINARY_CLOUD_NAME=djsf5jslk
CLOUDINARY_API_KEY=887592366968986
CLOUDINARY_API_SECRET=NDDSwTKs5lg3fHi9ASMOjwYwE20

# Global multer ceiling. Cloudinary's FREE plan actually caps per-file uploads
# well below this: images & raw documents 10MB, videos 100MB. Those per-type
# caps are enforced in middleware/upload.js (enforceCloudinaryLimits) with
# clear error messages, and can be raised via CLOUDINARY_*_MAX_MB below if
# the Cloudinary account is upgraded.
MAX_UPLOAD_MB=100
CLOUDINARY_IMAGE_MAX_MB=10
CLOUDINARY_VIDEO_MAX_MB=100
CLOUDINARY_RAW_MAX_MB=10

# Error monitoring — leave blank to disable Sentry entirely
SENTRY_DSN=

