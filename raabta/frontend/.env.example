# Backend API base URL. Never hardcode localhost — set this per-environment
# (local dev, Vercel preview, Vercel production).
VITE_API_BASE_URL=http://localhost:5000/api

# Google Analytics 4 — leave blank to disable analytics entirely (no script
# is loaded and the cookie-consent banner won't render).
VITE_GA_MEASUREMENT_ID=

# Sentry (frontend error monitoring) — leave blank to disable.
VITE_SENTRY_DSN=
